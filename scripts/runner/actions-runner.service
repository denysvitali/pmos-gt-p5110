[Unit]
Description=GitHub Actions runner (Debian chroot)
After=network-online.target
Wants=network-online.target

[Service]
# The battery must be able to absorb a build (docs/bringup.md B5/B6).
ExecCondition=/bin/sh -c 'test "$(cat /sys/class/power_supply/max170xx_battery/capacity)" -ge 30'
ExecStartPre=/usr/local/sbin/runner-chroot-mounts up
ExecStart=/usr/sbin/chroot /srv/runner-debian /usr/sbin/runuser -u runner -- /home/runner/actions-runner/run.sh
ExecStopPost=/usr/local/sbin/runner-chroot-mounts down
KillMode=process
KillSignal=SIGINT
Restart=always
RestartSec=30
# Builds must not starve the kiosk UI. One core: full 2-core load drains the
# battery (-100 mA net on a Pi 4 port), one core still charges (+155 mA).
CPUQuota=100%
CPUWeight=idle
IOWeight=10

[Install]
WantedBy=multi-user.target
