From: Denys Vitali <denys@denv.it>
Subject: [PATCH] power: supply: smb347: probe without battery info, add USB HC mode

Three problems seen on the Samsung Galaxy Tab 2 10.1 (espresso10):

- power_supply_get_battery_info() returns -ENOENT when there is no
  monitored-battery property (fwnode_find_reference()), which
  smb347_get_battery_info() treats as fatal: probe fails with -2.
- The driver never selects the input mode. The chip's non-volatile
  defaults choose USB1/USB5/HC by pin, which here means USB5 (500 mA),
  less than the system load. The vendor kernel clears the pin control in
  CFG_PIN and writes CMD_B (HC for a charger).
- The configuration is volatile and the chip reloads its NV defaults on
  input transitions (observed after a VBUS over-current cut), while the
  register cache still holds the programmed values.

Accept -ENOENT. Add an opt-in "summit,usb-hc-mode": program HC mode in
hw_init, keep CMD_B uncached, and check it every 5 s. When it is lost,
drop the cache and re-run hw_init and the IRQ setup. See pmos-galaxy
docs/bringup.md B6 for the register measurements.
---
--- a/Documentation/devicetree/bindings/power/supply/summit,smb347-charger.yaml	2026-11-17 06:59:12.161996095 +0000
+++ b/Documentation/devicetree/bindings/power/supply/summit,smb347-charger.yaml	2026-11-17 07:01:12.036434171 +0000
@@ -33,6 +33,14 @@
     type: boolean
     description: Provide power for USB OTG
 
+  summit,usb-hc-mode:
+    type: boolean
+    description:
+      Select USB high-current mode through the command register instead of the
+      USB5/1/HC pin, so that summit,usb-current-limit-microamp applies. The
+      driver re-applies its configuration whenever the chip reloads its
+      non-volatile defaults.
+
   summit,enable-mains-charging:
     type: boolean
     description: Enable charging through mains
--- a/drivers/power/supply/smb347-charger.c	2026-11-17 06:59:11.574003756 +0000
+++ b/drivers/power/supply/smb347-charger.c	2026-11-17 07:00:47.960747869 +0000
@@ -9,6 +9,7 @@
  */
 
 #include <linux/delay.h>
+#include <linux/devm-helpers.h>
 #include <linux/err.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
@@ -57,6 +58,11 @@
 #define CFG_PIN_EN_APSD_IRQ			BIT(1)
 #define CFG_PIN_EN_CHARGER_ERROR		BIT(2)
 #define CFG_PIN_EN_CTRL				BIT(4)
+/*
+ * In HC mode BIT(4) and BIT(3) must be clear: USB1/USB5/HC selected through
+ * CMD_B rather than the USB5/1/HC pin (values from the vendor driver).
+ */
+#define CFG_PIN_USB_MODE_PIN_MASK		(BIT(4) | BIT(3))
 #define CFG_THERM				0x07
 #define CFG_THERM_SOFT_HOT_COMPENSATION_MASK	0x03
 #define CFG_THERM_SOFT_HOT_COMPENSATION_SHIFT	0
@@ -99,6 +105,8 @@
 #define CMD_A_OTG_ENABLED			BIT(4)
 #define CMD_A_ALLOW_WRITE			BIT(7)
 #define CMD_B					0x31
+#define CMD_B_HC_MODE				BIT(0)
+#define CMD_B_USB5_MODE				BIT(1)
 #define CMD_C					0x33
 
 /* Interrupt Status registers */
@@ -172,6 +180,9 @@
  * @use_mains: AC/DC input can be used
  * @use_usb: USB input can be used
  * @use_usb_otg: USB OTG output can be used (not implemented yet)
+ * @use_usb_hc: select USB high-current mode through CMD_B
+ * @hc_work: re-applies the configuration after the chip reloads its
+ *	     non-volatile defaults (e.g. after a VBUS drop)
  * @enable_control: how charging enable/disable is controlled
  *		    (driver/pin controls)
  * @inok_polarity: polarity of INOK signal which denotes presence of external
@@ -223,6 +234,8 @@
 	bool			use_mains;
 	bool			use_usb;
 	bool			use_usb_otg;
+	bool			use_usb_hc;
+	struct delayed_work	hc_work;
 	unsigned int		enable_control;
 	unsigned int		inok_polarity;
 };
@@ -780,6 +793,18 @@
 	if (ret < 0)
 		goto fail;
 
+	if (smb->use_usb_hc) {
+		ret = regmap_update_bits(smb->regmap, CFG_PIN,
+					 CFG_PIN_USB_MODE_PIN_MASK, 0);
+		if (ret < 0)
+			goto fail;
+
+		ret = regmap_write(smb->regmap, CMD_B,
+				   CMD_B_HC_MODE | CMD_B_USB5_MODE);
+		if (ret < 0)
+			goto fail;
+	}
+
 	ret = smb347_update_ps_status(smb);
 	if (ret < 0)
 		goto fail;
@@ -1201,6 +1226,9 @@
 	case STAT_C:
 	case STAT_E:
 		return true;
+	case CMD_B:
+		/* Read back to detect a reload of the NV defaults. */
+		return true;
 	}
 
 	return false;
@@ -1266,6 +1294,7 @@
 	smb->use_mains = device_property_read_bool(dev, "summit,enable-mains-charging");
 	smb->use_usb = device_property_read_bool(dev, "summit,enable-usb-charging");
 	smb->use_usb_otg = device_property_read_bool(dev, "summit,enable-otg-charging");
+	smb->use_usb_hc = device_property_read_bool(dev, "summit,usb-hc-mode");
 
 	/* Select charging control */
 	device_property_read_u32(dev, "summit,enable-charge-control",
@@ -1291,7 +1320,8 @@
 		supply = smb->usb;
 
 	err = power_supply_get_battery_info(supply, &info);
-	if (err == -ENXIO || err == -ENODEV)
+	/* -ENOENT: no monitored-battery property */
+	if (err == -ENXIO || err == -ENODEV || err == -ENOENT)
 		return 0;
 	if (err)
 		return err;
@@ -1528,6 +1558,60 @@
 	.n_voltages	= 1,
 };
 
+#define SMB347_HC_CHECK_INTERVAL	msecs_to_jiffies(5000)
+
+/*
+ * Configuration and command registers are mirrored to volatile RAM, which the
+ * chip reloads from its non-volatile defaults on some input transitions. The
+ * defaults select the USB mode by pin (100/500 mA). Detect that through CMD_B
+ * and program everything again; the register cache is stale at that point.
+ */
+static void smb347_hc_work(struct work_struct *work)
+{
+	struct smb347_charger *smb = container_of(to_delayed_work(work),
+						  struct smb347_charger, hc_work);
+	unsigned int cmd_b;
+	int ret;
+
+	ret = regmap_read(smb->regmap, CMD_B, &cmd_b);
+	if (ret < 0) {
+		dev_warn(smb->dev, "reading CMD_B failed: %d\n", ret);
+		goto out;
+	}
+	if (cmd_b & CMD_B_HC_MODE)
+		goto out;
+
+	dev_info(smb->dev, "configuration lost (CMD_B=%#x), re-initialising\n",
+		 cmd_b);
+	regcache_drop_region(smb->regmap, 0, SMB347_MAX_REGISTER);
+
+	ret = smb347_hw_init(smb);
+	if (ret < 0) {
+		dev_err(smb->dev, "re-initialisation failed: %d\n", ret);
+		goto out;
+	}
+
+	if (!smb->irq_unsupported) {
+		ret = smb347_set_writable(smb, true, false);
+		if (!ret)
+			ret = regmap_update_bits(smb->regmap, CFG_STAT,
+						 CFG_STAT_ACTIVE_HIGH | CFG_STAT_DISABLED,
+						 CFG_STAT_DISABLED);
+		smb347_set_writable(smb, false, false);
+		if (!ret)
+			ret = smb347_irq_set(smb, true);
+		if (ret < 0)
+			dev_warn(smb->dev, "restoring IRQ setup failed: %d\n", ret);
+	}
+
+	if (smb->use_mains)
+		power_supply_changed(smb->mains);
+	if (smb->use_usb)
+		power_supply_changed(smb->usb);
+out:
+	schedule_delayed_work(&smb->hc_work, SMB347_HC_CHECK_INTERVAL);
+}
+
 static int smb347_probe(struct i2c_client *client)
 {
 	const struct i2c_device_id *id = i2c_client_get_device_id(client);
@@ -1592,6 +1676,14 @@
 		return PTR_ERR(smb->usb_rdev);
 	}
 
+	if (smb->use_usb_hc) {
+		ret = devm_delayed_work_autocancel(dev, &smb->hc_work,
+						   smb347_hc_work);
+		if (ret)
+			return ret;
+		schedule_delayed_work(&smb->hc_work, SMB347_HC_CHECK_INTERVAL);
+	}
+
 	return 0;
 }
 
@@ -1599,6 +1691,10 @@
 {
 	struct smb347_charger *smb = i2c_get_clientdata(client);
 
+	/* The work re-enables IRQs; stop it before tearing them down. */
+	if (smb->use_usb_hc)
+		cancel_delayed_work_sync(&smb->hc_work);
+
 	smb347_usb_vbus_regulator_disable(smb->usb_rdev);
 	smb347_irq_disable(smb);
 }
