From: Denys Vitali <denys@denv.it>
Subject: [PATCH] Input: twl4030-pwrbutton: TWL6032 support; ARM: dts: twl6032: add pwrbutton

espresso (TWL6032) includes twl6032.dtsi, so the pwrbutton node added to
twl6030.dtsi never reached it: no power key at all. On TWL6032,
STS_HW_CONDITIONS bit 0 (STS_PWRON) reads 1 while the button is released
(idle 0x3b). The twl6030 handling reports KEY_POWER = bit 0, so the key looked held
down whenever released and autorepeated (~36 events/s into gnome-shell). Add a
ti,twl6032-pwrbutton compatible with active-low STS_PWRON and use it in
twl6032.dtsi. twl6030 boards are unchanged.
---
--- a/arch/arm/boot/dts/ti/omap/twl6032.dtsi	2026-11-19 18:57:31.544996317 +0000
+++ b/arch/arm/boot/dts/ti/omap/twl6032.dtsi	2026-11-19 18:57:50.112757142 +0000
@@ -74,4 +74,9 @@
 		compatible = "ti,twl6030-pwmled";
 		#pwm-cells = <2>;
 	};
+
+	twl_pwrbutton: pwrbutton {
+		compatible = "ti,twl6032-pwrbutton", "ti,twl6030-pwrbutton";
+		interrupts = <0>;
+	};
 };
--- a/drivers/input/misc/twl4030-pwrbutton.c	2026-11-19 18:57:31.229000387 +0000
+++ b/drivers/input/misc/twl4030-pwrbutton.c	2026-11-19 18:57:50.108757194 +0000
@@ -37,6 +37,8 @@
 struct twl_pwrbutton_chipdata {
 	u8 status_reg;
 	bool need_manual_irq;
+	/* STS_PWRON reads 1 while the button is released */
+	bool active_low;
 };
 
 static const struct twl_pwrbutton_chipdata twl4030_chipdata = {
@@ -49,6 +51,12 @@
 	.need_manual_irq = true,
 };
 
+static const struct twl_pwrbutton_chipdata twl6032_chipdata = {
+	.status_reg = 0x2,
+	.need_manual_irq = true,
+	.active_low = true,
+};
+
 static irqreturn_t powerbutton_irq(int irq, void *_pwr)
 {
 	struct input_dev *pwr = _pwr;
@@ -58,8 +66,12 @@
 
 	err = twl_i2c_read_u8(TWL_MODULE_PM_MASTER, &value, pdata->status_reg);
 	if (!err)  {
+		bool pressed = value & PWR_PWRON_IRQ;
+
+		if (pdata->active_low)
+			pressed = !pressed;
 		pm_wakeup_event(pwr->dev.parent, 0);
-		input_report_key(pwr, KEY_POWER, value & PWR_PWRON_IRQ);
+		input_report_key(pwr, KEY_POWER, pressed);
 		input_sync(pwr);
 	} else {
 		dev_err(pwr->dev.parent, "twl4030: i2c error %d while reading"
@@ -139,6 +151,10 @@
 		.data = &twl4030_chipdata,
 	},
 	{
+		.compatible = "ti,twl6032-pwrbutton",
+		.data = &twl6032_chipdata,
+	},
+	{
 		.compatible = "ti,twl6030-pwrbutton",
 		.data = &twl6030_chipdata,
 	},
