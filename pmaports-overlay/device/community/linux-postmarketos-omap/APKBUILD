# Kernel config based on: arch/arm/configs/omap2plus_defconfig
maintainer="Mithil Bavishi <bavishimithil@gmail.com>"
pkgname=linux-postmarketos-omap
pkgver=7.1.5
pkgrel=59
pkgdesc="Mainline kernel fork for OMAP devices (pmos-galaxy: + openpvrsgx DDK 1.17)"
arch="armv7"
url="https://kernel.org/"
license="GPL-2.0-only"
options="!check !strip !tracedeps pmb:cross-native pmb:kconfigcheck-community"
makedepends="
	bash
	bison
	gcc
	elfutils-dev
	findutils
	flex
	kmod
	linux-headers
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	xz
	zstd
"
_carch="arm"
_flavor="postmarketos-omap"
_config="config-$_flavor.armv7"

case $pkgver in
	*.*rc*)	_rc=1
	        _kernver=$(echo $pkgver | tr '_' '-');;
	*.*.0) _kernver=${pkgver%.0};;
	*.*.*) _kernver=$pkgver;;
esac

if [ $_rc ]
then
	_kernsrc="linux-$pkgver.tar.gz::https://git.kernel.org/torvalds/t/linux-$_kernver.tar.gz"
else
	_kernsrc="https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/linux-$_kernver.tar.xz"
fi

source="
	$_kernsrc
	$_config
	0001-iio-rescale-revert-logic.patch
	0002-hsi-dma-fix.patch
	0003-Add-TWL6030-power-button-support-to-twl-pwrbutton.patch
	0004-arm-dts-Add-barnesnoble-encore-support.patch
	0005-panel-Add-lg-ld070ws1-for-barnesnoble-encore.patch
	0006-omap4-cfi.patch
	0007-dt-bindings-extcon-add-Samsung-P30-connector.patch
	0008-extcon-add-Samsung-P30-connector-driver.patch
	0009-usb-musb-omap2430-handle-initial-ID-ground-transitio.patch
	0010-usb-phy-twl6030-add-extcon-and-external-VBUS-support.patch
	0011-ARM-dts-omap4-espresso-add-USB-OTG-support.patch
	0012-ARM-dts-omap4-espresso-reserve-secure-RAM.patch
	0013-power-supply-smb347-probe-without-battery-info-add-USB-HC-mode.patch
	0014-ARM-dts-omap4-espresso10-SMB347-HC-mode-battery-supplier.patch
	0015-mm-vmalloc-export-__vmalloc_node_range_noprof-for-pvrsgx.patch
	0017-ARM-dts-omap4-espresso-keep-the-LCD-supply-on.patch
	pvrsgx-1.17.patch.xz
"
builddir="$srcdir/linux-$_kernver"
replaces="linux-samsung-espresso3g linux-nokia-n900"

prepare() {
	default_prepare
	cp -v "$srcdir"/$_config .config
	# A unique kernel release per pkgrel (7.1.5-rN), so the previous kernel's
	# modules can stay installed next to the new ones for the B slot
	# (scripts/kernel-ab.sh). Modules must come from the same build (BTF).
	grep -qx 'CONFIG_LOCALVERSION=""' .config || die "unexpected CONFIG_LOCALVERSION"
	sed -i "s/^CONFIG_LOCALVERSION=\"\"$/CONFIG_LOCALVERSION=\"-r$pkgrel\"/" .config
	grep -qx "CONFIG_LOCALVERSION=\"-r$pkgrel\"" .config || die "CONFIG_LOCALVERSION not set"
	make ARCH="$_carch" olddefconfig
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	# modules_install falls back to busybox depmod without kmod, which cannot
	# read .ko.zst: empty modules.alias, no dependencies (pmos-galaxy B8).
	local _mods="$pkgdir/usr/lib/modules/$(cat "$builddir"/include/config/kernel.release)"
	if [ ! -s "$_mods/modules.alias" ] || ! grep -q "^alias fs-ext2 " "$_mods/modules.alias"; then
		error "depmod produced no module aliases in $_mods"
		return 1
	fi
}

