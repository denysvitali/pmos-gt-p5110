a917cee7fa9ada1deded9b70bdc34a921ac9bb0a8b3e401a6cbfba4d5f07fd725dee74a1e5ddc237a8f5753956ea7ae722405c0e1f694ad36dfea933fa1d23b7  sgx-ddk-um.initd
"
