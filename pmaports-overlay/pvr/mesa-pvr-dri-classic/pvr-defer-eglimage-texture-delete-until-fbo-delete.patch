From: pmos-galaxy
Subject: [PATCH] pvr: defer deleting EGLImage textures until their FBOs are deleted

SGX540 DDK 1.17: an FBO whose colour attachment was an EGLImage texture keeps
a pointer to the image memory's sync object after the attachment is dropped
(explicit detach, or glDeleteTextures while the FBO is bound). When the image
memory is freed before the FBO is deleted, glDeleteFramebuffers flushes the
FBO, waits on the freed sync and crashes in libGLESv2_PVR_MESA.so + 0x16e6c
(gnome-shell with hardware EGL Wayland clients), or spins in the wait.
Reproduced standalone; plain textures and still-attached image textures are
not affected (pmos-galaxy docs/bringup.md B17).

mutter also hits it through offscreen FBOs on plain textures that it draws
the client's EGLImage textures into (seen with PVR_FBO_DEFER_DEBUG=1).

Wrap glEGLImageTargetTexture2DOES, glFramebufferTexture2D, glActiveTexture,
glBindTexture, glBindFramebuffer, glDrawArrays, glDrawElements,
glDeleteTextures and glDeleteFramebuffers in the GLES2 dispatch table. An FBO
references an EGLImage texture that is attached to it or bound on a unit
during a draw into it. Such a texture is really deleted only after every FBO
of the current context that references it.

Deferring the texture alone is not enough (r60 still crashed): the blob
texture does not keep the image's buffer alive, so eglDestroyImage freed the
memory and its sync anyway. Each image texture now also holds a __DRIimage
reference until its real deletion. PVR_FBO_DEFER_DEBUG=1 logs every wrapped call.
---
--- a/src/mesa/drivers/dri/pvr/mesa_context.c	2026-11-20 09:02:48.952794941 +0000
+++ b/src/mesa/drivers/dri/pvr/mesa_context.c	2026-11-20 11:48:04.384275459 +0000
@@ -34,8 +34,11 @@
  */
 
 #include <stdlib.h>
+#include <string.h>
 #include <dlfcn.h>
 #include <assert.h>
+#include <pthread.h>
+#include <stdio.h>
 
 #include "main/version.h"
 #include "main/errors.h"
@@ -145,6 +148,480 @@
 	}
 }
 
+/*
+ * SGX540 DDK 1.17 workaround: an FBO whose colour attachment was an
+ * EGLImage texture keeps a pointer to the image memory's sync object after
+ * the attachment is dropped (explicit detach, or glDeleteTextures while the
+ * FBO is bound). If the image memory is freed before the FBO is deleted,
+ * glDeleteFramebuffers flushes the FBO, waits on the freed sync and crashes
+ * (libGLESv2_PVR_MESA.so + 0x16e6c) or spins. Plain textures and image
+ * textures that stay attached are not affected.
+ *
+ * mutter also hits it with offscreen FBOs on plain textures that it draws the
+ * client's EGLImage textures into, so an FBO references an image texture when
+ * the texture is attached to it or bound on a unit during a draw into it.
+ *
+ * The real deletion of an EGLImage texture referenced by a still-live FBO of
+ * this context is deferred until those FBOs are deleted. The blob texture does
+ * not keep the image's buffer alive, so each image texture also holds a
+ * __DRIimage reference until its real deletion; otherwise eglDestroyImage
+ * frees the memory (and its sync) under the deferred texture.
+ */
+typedef void (*pvr_delete_fn)(GLsizei, const GLuint *);
+typedef void (*pvr_fbtex_fn)(GLenum, GLenum, GLenum, GLuint, GLint);
+typedef void (*pvr_eglimage_fn)(GLenum, void *);
+typedef void (*pvr_getint_fn)(GLenum, GLint *);
+typedef void (*pvr_active_fn)(GLenum);
+typedef void (*pvr_bind_fn)(GLenum, GLuint);
+typedef void (*pvr_drawarrays_fn)(GLenum, GLint, GLsizei);
+typedef void (*pvr_drawelements_fn)(GLenum, GLsizei, GLenum, const void *);
+
+#define PVR_MAX_UNITS 16
+/* Bindings as the application set them, per context. */
+struct pvr_ctx_state { void *ctx; GLuint fbo; GLuint unit; GLuint tex[PVR_MAX_UNITS]; };
+
+struct pvr_fbo_att { void *ctx; GLuint fbo; GLuint tex; };
+struct pvr_img_tex { void *ctx; GLuint tex; int deferred; __DRIimage *psDRIImage; };
+
+static pthread_mutex_t gsWrapLock = PTHREAD_MUTEX_INITIALIZER;
+static __thread void *gpvCurCtx;
+static pvr_delete_fn real_DeleteTextures, real_DeleteFramebuffers;
+static pvr_fbtex_fn real_FramebufferTexture2D;
+static pvr_eglimage_fn real_EGLImageTargetTexture2DOES;
+static pvr_getint_fn real_GetIntegerv;
+static pvr_active_fn real_ActiveTexture;
+static pvr_bind_fn real_BindTexture, real_BindFramebuffer;
+static pvr_drawarrays_fn real_DrawArrays;
+static pvr_drawelements_fn real_DrawElements;
+static struct pvr_ctx_state *gpsState;
+static unsigned guState, guStateCap;
+static struct pvr_fbo_att *gpsAtt;
+static unsigned guAtt, guAttCap;
+static struct pvr_img_tex *gpsImg;
+static unsigned guImg, guImgCap;
+
+/* PVR_FBO_DEFER_DEBUG=1: log every wrapped call to stderr. */
+static int giDebug = -1;
+#define PVR_DBG(...) do { \
+	if (giDebug < 0) { const char *e = getenv("PVR_FBO_DEFER_DEBUG"); giDebug = e && *e == '1'; } \
+	if (giDebug) fprintf(stderr, "pvr-fbo-defer: " __VA_ARGS__); \
+} while (0)
+
+#define PVR_TEXTURE_2D 0x0DE1
+#define PVR_TEXTURE_BINDING_2D 0x8069
+#define PVR_FRAMEBUFFER_BINDING 0x8CA6
+
+static struct pvr_img_tex *pvr_find_img(GLuint tex)
+{
+	for (unsigned i = 0; i < guImg; i++)
+		if (gpsImg[i].ctx == gpvCurCtx && gpsImg[i].tex == tex)
+			return &gpsImg[i];
+	return NULL;
+}
+
+static int pvr_tex_attached(GLuint tex)
+{
+	for (unsigned i = 0; i < guAtt; i++)
+		if (gpsAtt[i].ctx == gpvCurCtx && gpsAtt[i].tex == tex)
+			return 1;
+	return 0;
+}
+
+/* Remove an entry; returns its image reference for the caller to drop. */
+static __DRIimage *pvr_drop_img(struct pvr_img_tex *psImg)
+{
+	__DRIimage *psDRIImage = psImg->psDRIImage;
+
+	*psImg = gpsImg[--guImg];
+	return psDRIImage;
+}
+
+/* The calling thread's context state; created on first use. Lock held. */
+static struct pvr_ctx_state *pvr_state(void)
+{
+	for (unsigned i = 0; i < guState; i++)
+		if (gpsState[i].ctx == gpvCurCtx)
+			return &gpsState[i];
+	if (!gpvCurCtx)
+		return NULL;
+	if (guState == guStateCap)
+	{
+		unsigned uCap = guStateCap ? guStateCap * 2 : 4;
+		void *pv = realloc(gpsState, uCap * sizeof(*gpsState));
+		if (!pv)
+			return NULL;
+		gpsState = pv;
+		guStateCap = uCap;
+	}
+	gpsState[guState] = (struct pvr_ctx_state){ .ctx = gpvCurCtx };
+	return &gpsState[guState++];
+}
+
+/* Record that fbo references image texture tex. Lock held. */
+static void pvr_add_ref(GLuint fbo, GLuint tex, const char *why)
+{
+	if (!fbo || !tex)
+		return;
+	for (unsigned i = 0; i < guAtt; i++)
+		if (gpsAtt[i].ctx == gpvCurCtx && gpsAtt[i].fbo == fbo && gpsAtt[i].tex == tex)
+			return;
+	if (guAtt == guAttCap)
+	{
+		unsigned uCap = guAttCap ? guAttCap * 2 : 32;
+		void *pv = realloc(gpsAtt, uCap * sizeof(*gpsAtt));
+		if (!pv)
+			return;
+		gpsAtt = pv;
+		guAttCap = uCap;
+	}
+	gpsAtt[guAtt++] = (struct pvr_fbo_att){ gpvCurCtx, fbo, tex };
+	PVR_DBG("ctx %p ref fbo %u tex %u (%s)\n", gpvCurCtx, fbo, tex, why);
+}
+
+static void
+wrap_ActiveTexture(GLenum texture)
+{
+	struct pvr_ctx_state *psState;
+
+	real_ActiveTexture(texture);
+	pthread_mutex_lock(&gsWrapLock);
+	psState = pvr_state();
+	if (psState && texture >= 0x84C0 && texture < 0x84C0 + PVR_MAX_UNITS)
+		psState->unit = texture - 0x84C0;
+	pthread_mutex_unlock(&gsWrapLock);
+}
+
+static void
+wrap_BindTexture(GLenum target, GLuint texture)
+{
+	struct pvr_ctx_state *psState;
+
+	real_BindTexture(target, texture);
+	if (target != PVR_TEXTURE_2D)
+		return;
+	pthread_mutex_lock(&gsWrapLock);
+	psState = pvr_state();
+	if (psState)
+		psState->tex[psState->unit] = texture;
+	pthread_mutex_unlock(&gsWrapLock);
+}
+
+static void
+wrap_BindFramebuffer(GLenum target, GLuint framebuffer)
+{
+	struct pvr_ctx_state *psState;
+
+	real_BindFramebuffer(target, framebuffer);
+	pthread_mutex_lock(&gsWrapLock);
+	psState = pvr_state();
+	if (psState)
+		psState->fbo = framebuffer;
+	pthread_mutex_unlock(&gsWrapLock);
+}
+
+/* A draw into an FBO references the image textures bound on any unit. */
+static void pvr_note_draw(void)
+{
+	struct pvr_ctx_state *psState;
+
+	pthread_mutex_lock(&gsWrapLock);
+	psState = pvr_state();
+	if (psState && psState->fbo && guImg)
+		for (unsigned u = 0; u < PVR_MAX_UNITS; u++)
+			if (psState->tex[u] && pvr_find_img(psState->tex[u]))
+				pvr_add_ref(psState->fbo, psState->tex[u], "draw");
+	pthread_mutex_unlock(&gsWrapLock);
+}
+
+static void
+wrap_DrawArrays(GLenum mode, GLint first, GLsizei count)
+{
+	pvr_note_draw();
+	real_DrawArrays(mode, first, count);
+}
+
+static void
+wrap_DrawElements(GLenum mode, GLsizei count, GLenum type, const void *indices)
+{
+	pvr_note_draw();
+	real_DrawElements(mode, count, type, indices);
+}
+
+static void
+wrap_EGLImageTargetTexture2DOES(GLenum target, void *image)
+{
+	struct pvr_img_tex *psImg;
+	__DRIimage *psDRIImage, *psOld = NULL;
+	GLint tex = 0;
+
+	real_EGLImageTargetTexture2DOES(target, image);
+	if (real_GetIntegerv)
+		real_GetIntegerv(PVR_TEXTURE_BINDING_2D, &tex);
+	psDRIImage = PVRDRIScreenGetDRIImage(image);
+	PVR_DBG("ctx %p image-target target %#x tex %d image %p\n", gpvCurCtx, target,
+		tex, (void *)psDRIImage);
+	if (target != PVR_TEXTURE_2D || !real_GetIntegerv || tex == 0)
+		return;
+
+	pthread_mutex_lock(&gsWrapLock);
+	psImg = pvr_find_img(tex);
+	if (!psImg)
+	{
+		if (guImg == guImgCap)
+		{
+			unsigned uCap = guImgCap ? guImgCap * 2 : 32;
+			void *pv = realloc(gpsImg, uCap * sizeof(*gpsImg));
+			if (!pv)
+				goto out;
+			gpsImg = pv;
+			guImgCap = uCap;
+		}
+		psImg = &gpsImg[guImg++];
+		*psImg = (struct pvr_img_tex){ gpvCurCtx, tex, 0, NULL };
+	}
+	if (psImg->psDRIImage != psDRIImage)
+	{
+		psOld = psImg->psDRIImage;
+		psImg->psDRIImage = psDRIImage;
+		if (psDRIImage)
+			PVRDRIRefImage(psDRIImage);
+	}
+out:
+	pthread_mutex_unlock(&gsWrapLock);
+	if (psOld)
+		PVRDRIUnrefImage(psOld);
+}
+
+static void
+wrap_FramebufferTexture2D(GLenum target, GLenum attachment, GLenum textarget,
+			  GLuint texture, GLint level)
+{
+	GLint fbo = 0;
+	int bImg;
+
+	real_FramebufferTexture2D(target, attachment, textarget, texture, level);
+	if (!real_GetIntegerv)
+		return;
+	real_GetIntegerv(PVR_FRAMEBUFFER_BINDING, &fbo);
+
+	pthread_mutex_lock(&gsWrapLock);
+	bImg = texture && pvr_find_img(texture);
+	PVR_DBG("ctx %p fb-texture fbo %d att %#x textarget %#x tex %u img %d\n",
+		gpvCurCtx, fbo, attachment, textarget, texture, bImg);
+	if (bImg)
+		pvr_add_ref(fbo, texture, "attach");
+	pthread_mutex_unlock(&gsWrapLock);
+}
+
+static void
+wrap_DeleteTextures(GLsizei n, const GLuint *textures)
+{
+	GLuint auStack[16];
+	GLuint *puKeep = auStack;
+	GLsizei nKeep = 0;
+	__DRIimage *apsStack[16];
+	__DRIimage **ppsUnref = apsStack;
+	GLsizei nUnref = 0;
+
+	if (n <= 0 || !textures)
+	{
+		real_DeleteTextures(n, textures);
+		return;
+	}
+	if (n > 16)
+	{
+		puKeep = malloc(n * sizeof(*puKeep));
+		ppsUnref = malloc(n * sizeof(*ppsUnref));
+		if (!puKeep || !ppsUnref)
+		{
+			/* No memory to track: delete now, keep the references. */
+			free(puKeep);
+			free(ppsUnref);
+			real_DeleteTextures(n, textures);
+			return;
+		}
+	}
+
+	pthread_mutex_lock(&gsWrapLock);
+	{
+		struct pvr_ctx_state *psState = pvr_state();
+
+		/* GL unbinds deleted textures. */
+		for (GLsizei i = 0; psState && i < n; i++)
+			for (unsigned u = 0; u < PVR_MAX_UNITS; u++)
+				if (psState->tex[u] == textures[i])
+					psState->tex[u] = 0;
+	}
+	for (GLsizei i = 0; i < n; i++)
+	{
+		struct pvr_img_tex *psImg = pvr_find_img(textures[i]);
+
+		PVR_DBG("ctx %p delete-texture %u img %d attached %d\n", gpvCurCtx,
+			textures[i], psImg != NULL, psImg && pvr_tex_attached(textures[i]));
+		if (psImg && pvr_tex_attached(textures[i]))
+		{
+			psImg->deferred = 1;
+			continue;
+		}
+		if (psImg && (ppsUnref[nUnref] = pvr_drop_img(psImg)))
+			nUnref++;
+		puKeep[nKeep++] = textures[i];
+	}
+	pthread_mutex_unlock(&gsWrapLock);
+
+	if (nKeep)
+		real_DeleteTextures(nKeep, puKeep);
+	/* The buffers go only after the textures that used them. */
+	for (GLsizei i = 0; i < nUnref; i++)
+		PVRDRIUnrefImage(ppsUnref[i]);
+	if (puKeep != auStack)
+		free(puKeep);
+	if (ppsUnref != apsStack)
+		free(ppsUnref);
+}
+
+static void
+wrap_DeleteFramebuffers(GLsizei n, const GLuint *framebuffers)
+{
+	for (GLsizei j = 0; framebuffers && j < n; j++)
+		PVR_DBG("ctx %p delete-fbo %u\n", gpvCurCtx, framebuffers[j]);
+	/* Delete the FBOs first, while deferred textures are still alive. */
+	real_DeleteFramebuffers(n, framebuffers);
+	if (n <= 0 || !framebuffers)
+		return;
+
+	pthread_mutex_lock(&gsWrapLock);
+	{
+		struct pvr_ctx_state *psState = pvr_state();
+
+		/* GL rebinds 0 when the bound FBO is deleted. */
+		for (GLsizei j = 0; psState && j < n; j++)
+			if (psState->fbo == framebuffers[j])
+				psState->fbo = 0;
+	}
+	for (unsigned i = 0; i < guAtt; )
+	{
+		int bDrop = 0;
+
+		for (GLsizei j = 0; j < n && !bDrop; j++)
+			bDrop = gpsAtt[i].ctx == gpvCurCtx && gpsAtt[i].fbo == framebuffers[j];
+		if (bDrop)
+			gpsAtt[i] = gpsAtt[--guAtt];
+		else
+			i++;
+	}
+	for (unsigned i = 0; i < guImg; )
+	{
+		if (gpsImg[i].ctx == gpvCurCtx && gpsImg[i].deferred &&
+		    !pvr_tex_attached(gpsImg[i].tex))
+		{
+			GLuint tex = gpsImg[i].tex;
+			__DRIimage *psDRIImage = pvr_drop_img(&gpsImg[i]);
+
+			PVR_DBG("ctx %p deferred delete-texture %u\n", gpvCurCtx, tex);
+			real_DeleteTextures(1, &tex);
+			if (psDRIImage)
+				PVRDRIUnrefImage(psDRIImage);
+		}
+		else
+		{
+			i++;
+		}
+	}
+	pthread_mutex_unlock(&gsWrapLock);
+}
+
+/* Forget a destroyed context, so a new one at the same address starts clean. */
+void
+pvrdri_forget_context(PVRDRIContext *psPVRContext)
+{
+	pthread_mutex_lock(&gsWrapLock);
+	for (unsigned i = 0; i < guAtt; )
+	{
+		if (gpsAtt[i].ctx == psPVRContext)
+			gpsAtt[i] = gpsAtt[--guAtt];
+		else
+			i++;
+	}
+	for (unsigned i = 0; i < guImg; )
+	{
+		if (gpsImg[i].ctx == psPVRContext)
+			(void)pvr_drop_img(&gpsImg[i]); /* the image reference is leaked on purpose:
+							 * share-group textures may still use it */
+		else
+			i++;
+	}
+	for (unsigned i = 0; i < guState; i++)
+		if (gpsState[i].ctx == psPVRContext)
+		{
+			gpsState[i] = gpsState[--guState];
+			break;
+		}
+	pthread_mutex_unlock(&gsWrapLock);
+}
+
+static _glapi_proc
+pvrdri_wrap_func(PVRDRIAPIType eAPI, void *pvLibHandle, const char *psFunc,
+		 _glapi_proc pfFunc)
+{
+	if (eAPI != PVRDRI_API_GLES2)
+		return pfFunc;
+
+	if (!real_GetIntegerv)
+		real_GetIntegerv = (pvr_getint_fn)dlsym(pvLibHandle, "glGetIntegerv");
+
+	if (!strcmp(psFunc, "glEGLImageTargetTexture2DOES"))
+	{
+		real_EGLImageTargetTexture2DOES = (pvr_eglimage_fn)pfFunc;
+		return (_glapi_proc)wrap_EGLImageTargetTexture2DOES;
+	}
+	if (!strcmp(psFunc, "glFramebufferTexture2D") ||
+	    !strcmp(psFunc, "glFramebufferTexture2DOES"))
+	{
+		real_FramebufferTexture2D = (pvr_fbtex_fn)pfFunc;
+		return (_glapi_proc)wrap_FramebufferTexture2D;
+	}
+	if (!strcmp(psFunc, "glActiveTexture"))
+	{
+		real_ActiveTexture = (pvr_active_fn)pfFunc;
+		return (_glapi_proc)wrap_ActiveTexture;
+	}
+	if (!strcmp(psFunc, "glBindTexture"))
+	{
+		real_BindTexture = (pvr_bind_fn)pfFunc;
+		return (_glapi_proc)wrap_BindTexture;
+	}
+	if (!strcmp(psFunc, "glBindFramebuffer") ||
+	    !strcmp(psFunc, "glBindFramebufferOES"))
+	{
+		real_BindFramebuffer = (pvr_bind_fn)pfFunc;
+		return (_glapi_proc)wrap_BindFramebuffer;
+	}
+	if (!strcmp(psFunc, "glDrawArrays"))
+	{
+		real_DrawArrays = (pvr_drawarrays_fn)pfFunc;
+		return (_glapi_proc)wrap_DrawArrays;
+	}
+	if (!strcmp(psFunc, "glDrawElements"))
+	{
+		real_DrawElements = (pvr_drawelements_fn)pfFunc;
+		return (_glapi_proc)wrap_DrawElements;
+	}
+	if (!strcmp(psFunc, "glDeleteTextures"))
+	{
+		real_DeleteTextures = (pvr_delete_fn)pfFunc;
+		return (_glapi_proc)wrap_DeleteTextures;
+	}
+	if (!strcmp(psFunc, "glDeleteFramebuffers") ||
+	    !strcmp(psFunc, "glDeleteFramebuffersOES"))
+	{
+		real_DeleteFramebuffers = (pvr_delete_fn)pfFunc;
+		return (_glapi_proc)wrap_DeleteFramebuffers;
+	}
+
+	return pfFunc;
+}
+
 static void
 pvrdri_add_mesa_dispatch(struct _glapi_table *psTable,
 			 PVRDRIAPIType eAPI,
@@ -176,6 +653,8 @@
 		}
 	}
 
+	pfFunc = pvrdri_wrap_func(eAPI, pvLibHandle, psFunc, pfFunc);
+
 	asFunc[0] = psFunc;
 	iOffset = _glapi_add_dispatch(asFunc, "");
 	if (iOffset == -1)
@@ -254,6 +733,7 @@
 void
 pvrdri_set_null_dispatch_table(void)
 {
+	gpvCurCtx = NULL;
 	_glapi_set_dispatch(NULL);
 }
 
@@ -262,5 +742,6 @@
 {
 	struct _glapi_table *psTable = pvrdri_get_dispatch_table(psPVRContext->psPVRScreen, psPVRContext->eAPI);
 
+	gpvCurCtx = psPVRContext;
 	_glapi_set_dispatch(psTable);
 }
