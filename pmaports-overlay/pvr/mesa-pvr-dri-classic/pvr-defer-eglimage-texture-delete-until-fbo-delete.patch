+++ b/src/mesa/drivers/dri/pvr/pvrdri.c	2026-11-20 09:04:03.083833491 +0000
@@ -945,6 +945,7 @@
 				 psPVRContext->eAPI,
 				 psPVRScreen->psImpl);
 
+	pvrdri_forget_context(psPVRContext);
 	free(psPVRContext);
 
 #if defined(DEBUG)
--- a/src/mesa/drivers/dri/pvr/pvrmesa.h	2026-11-20 09:04:02.935835410 +0000
+++ b/src/mesa/drivers/dri/pvr/pvrmesa.h	2026-11-20 09:04:03.083833491 +0000
@@ -38,4 +38,6 @@
 
 void pvrdri_set_dispatch_table(PVRDRIContext *psPVRContext);
 
+void pvrdri_forget_context(PVRDRIContext *psPVRContext);
+
 #endif /* !defined(__PVRMESA_H__) */
